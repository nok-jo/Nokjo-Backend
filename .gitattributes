# Normalize text files to LF in Git
* text=auto eol=lf

# Python
*.py text eol=lf

# Configuration
*.env text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary